{
  "name": "sherlock-immo",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "icons": "node scripts/make-icons.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.15",
    "@types/leaflet.markercluster": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "description": "Retrouver la maison d'une annonce immobilière et vérifier ce qu'elle ne dit pas, avec les données publiques françaises",
  "license": "MIT"
}
